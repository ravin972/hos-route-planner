# Reference only. Copy this file to `.env` in backend\ for local development if you want to keep
# values out of your shell -- config/settings.py loads `.env` via python-dotenv (real environment
# variables already set always take precedence; see README "Configuration"). Never put real values
# in THIS file (.env.example) and never commit a filled-in `.env` (it is git-ignored).

# ---- Django ----
# Required unless DJANGO_DEBUG=true.
DJANGO_SECRET_KEY=
# "true" for local development only. Defaults to false.
DJANGO_DEBUG=false
# Comma-separated host allow-list. Defaults to localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API. Defaults to http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Routing / geocoding (trips/routing) ----
# OpenRouteService / HeiGIT. Provide the key through the environment ONLY -- never hardcode it.
ORS_API_KEY=
# api.openrouteservice.org is deprecated and shut down 2026-09-28. Use the HeiGIT host.
ORS_BASE_URL=https://api.heigit.org/openrouteservice
# Photon typeahead instance. Defaults to the public Photon service.
# PHOTON_BASE_URL=

# ---- Planning parameters ----
# Average truck speed in mph used for drive-time estimates. Defaults to 55; tests use 50.
# AVG_TRUCK_SPEED_MPH=55
# Timeout in seconds for routing/geocoding HTTP calls. Defaults to 10.
# UPSTREAM_TIMEOUT_S=10

# ---- Throttling ----
# THROTTLE_PLAN=30/min
# THROTTLE_SEARCH=120/min

# ---- Optional log-sheet header fields (blank by default) ----
# LOG_CARRIER_NAME=
# LOG_MAIN_OFFICE=
# LOG_HOME_TERMINAL=
# LOG_TRUCK_NUMBER=
