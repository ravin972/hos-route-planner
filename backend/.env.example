# Reference only. The application reads REAL environment variables and does NOT load this file
# (there is no python-dotenv). Set them in your shell (PowerShell: $env:NAME = "value") or in the
# hosting dashboard. Never put real values in this file and never commit a filled-in copy.

# ---- Read by config/settings.py today (Phase 0) ----
# Required unless DJANGO_DEBUG=true.
DJANGO_SECRET_KEY=
# "true" for local development only. Defaults to false.
DJANGO_DEBUG=false
# Comma-separated host allow-list. Defaults to localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Reserved names: read by later phases, nothing consumes these yet ----
# Phase 1: planning speed in mph (documented default 55; tests use 50).
# AVG_TRUCK_SPEED_MPH=55
# Phase 2: OpenRouteService / HeiGIT. Provide the key through the environment ONLY.
# ORS_API_KEY=
# api.openrouteservice.org is deprecated and shuts down on 2026-09-28. Use the HeiGIT host.
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
